# Post-processing of the chunked V50nano_170pre6HLT caching, one job per sample (merge_chunks,
# make_hlt_sums, merge_arrays: scripts/condor/caching_170pre6HLT_post.sh). Submit after all
# chunk jobs succeeded; fpj must match the caching .sub files.
#   condor_submit scripts/condor/caching_170pre6HLT_post.sub
checkout       = $ENV(PWD)
logdir         = /eos/home-a/alobanov/SWAN_projects/L1TML/topo-hackathon-2026/projects/hlt-extension/condor_logs
executable     = $(checkout)/scripts/condor/menu_job.sh
arguments      = $(checkout) scripts/condor/caching_170pre6HLT_post.sh $(sample) $(fpj)
output         = $(logdir)/cache170pre6HLT_post_$(sample).out
error          = $(logdir)/cache170pre6HLT_post_$(sample).err
log            = $(logdir)/cache170pre6HLT.log
request_cpus   = 1
request_memory = 8000
+JobFlavour    = "longlunch"
queue sample, fpj from (
  DYLL_M50 25
  TT 25
  HHTo2B2Tau 25
  HHTo4B 25
  MinBias 125
)
