# Chunked caching of the V50nano_170pre6HLT MinBias sample (12,511 files x 160 events):
# 101 jobs of 125 files (sorted file order), ~6 min and < 1 GB each (local test: 2.6 s/file,
# 280 MB for 20 files). Output: $MENU_TOOLS_CACHE/V50nano_170pre6HLT/chunks/.
# Submit from the checkout to run (code is taken from $(checkout) = submit dir), with the
# EOS submit pool:
#   export _myschedd_POOL=eossubmit _condor_CONDOR_HOST="tweetybird04.cern.ch, tweetybird03.cern.ch"
#   condor_submit scripts/condor/caching_170pre6HLT_minbias.sub            # all chunks
#   condor_submit scripts/condor/caching_170pre6HLT_minbias.sub first=0 last=0          # one test chunk
# Then: scripts/condor/caching_170pre6HLT_post.sub (merge, hltPuppiJetSums, L1EG).
checkout       = $ENV(PWD)
# extra cache_objects arguments and a log-name tag, e.g. to add one object to existing chunks:
#   condor_submit <this>.sub extra="--objects hltPFPuppiHT" logtag=_HT
if ! defined extra
  extra =
endif
if ! defined logtag
  logtag =
endif
logdir         = /eos/home-a/alobanov/SWAN_projects/L1TML/topo-hackathon-2026/projects/hlt-extension/condor_logs
fpj            = 125
executable     = $(checkout)/scripts/condor/menu_job.sh
arguments      = $(checkout) cache_objects configs/V50nano/cache_objects/caching_170pre6_HLT.yaml --samples MinBias --files-per-job $(fpj) --job $(job) $(extra)
output         = $(logdir)/cache170pre6HLT_MinBias$(logtag).$(job).out
error          = $(logdir)/cache170pre6HLT_MinBias$(logtag).$(job).err
log            = $(logdir)/cache170pre6HLT.log
request_cpus   = 1
request_memory = 2000
+JobFlavour    = "microcentury"
if ! defined first
  first = 0
endif
if ! defined last
  last = 100
endif
queue job from seq $(first) $(last) |
